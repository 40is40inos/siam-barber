# Nothing here is required for local development: the database defaults to data/siam-barber.db,
# and the admin password is created by the barber on his first visit to /admin.

# Database for hosting (Cloudflare Workers needs one; a local file won't work there).
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Optional fallback admin password, only used until a password is created at /admin.
# ADMIN_PASSWORD=
