# Password the barber uses at /admin
ADMIN_PASSWORD=change-me
# Any long random string; signs the barber's login cookie
SESSION_SECRET=change-me-too

# Database. Defaults to a local SQLite file.
# For hosting: a Turso database (libsql://...) plus its token,
# or file:/path/on/a/persistent/disk when running on a VPS.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=
